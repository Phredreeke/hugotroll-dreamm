desc[ite-hugolabyrinth]:

name = Hugo Labyrinth
icon = ite-hugolabyrinth.png
machine = pc
rootpath = C:\
launch = $(rootpath)\HUGO.EXE
osenv = dos
fixdivover = true
mips = $(MIPS_386SX_20)
ramkb = 16384
audiohw = sb16
videohw = vga


//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Video options
//
VIDOPTIONS = true
config[vidoptions]:
    condition = $(VIDOPTIONS)
    title = Graphics Configuration
    option[ega]: name = $(EGA_NAME); TEMPTHROTTLE = 161; videohw = ega; 
    option[vga]: name = $(VGA_NAME); TEMPTHROTTLE = 142; priority = 1;
end
SKIPOPTION = false
config[skipoptions]:
    condition = $(SKIPOPTION)
    title = Intro Configuration
    option[noskip]: name = Normal;  
    option[fast]: name = Skip credits; nothrottle = $(TEMPTHROTTLE); priority = 1;
end



//
// English DOS version 
//
game[pc-940827]:
    name = English DOS
    anchorfile = HUGO.EXE
    file[]: crc = 0539b2dc; size =   1072340; name = HUGO.001
    file[]: crc = 59b378b3; size =      3160; name = HUGO.DIR
    file[]: crc = 04281767; size =    102395; name = Hugo.exe

end


