desc[ite-hugo3]:

name = Hugo 3
icon = ite-hugo3.png
machine = pc
rootpath = C:\
launch = $(rootpath)\HUGO.EXE
osenv = windows
winres=640x480x8
LANGSELECT = false
LANGCONFIG = Machine.cnf


$(include cfg-hugo3.inc)
$(include cfg-hugo-multilang.inc)


//
// Throttle enter press
//
script[remap]:
    condition = $(ENTERTHROTTLE)
    code = [[[$(CRLF)
       keyboard_install_hook(0x28, "remap");
       func remap() {
       keyboard_lockout(true);
       keyboard_type("`28"); 
       sleep(20);
       keyboard_lockout(false);
       }
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

fragment[base-dos]:
    osenv = dos
    fixdivover = true
    mips = $(MIPS_P100)
    ramkb = 16384
    audiohw = sb16
    videohw = svga
    ENTERTHROTTLE = false
end

//
// Setup
//
configutil[]:
    name = Sound setup
    launch = $(rootpath)\SNDSETUP.EXE
    condition = file_exists("$(rootpath)\SNDSETUP.EXE")
end

//
// Language options
//
config[langselect]:
    condition = $(LANGSELECT)
    title = Language Configuration
//    option[en]: name = English; LANGCONFIG = Machineuk.cnf;
    option[dk]: name = Danish; LANGCONFIG = Machinedk.cnf;
    option[fi]: name = Finnish; LANGCONFIG = Machinefi.cnf;	
    option[no]: name = Norwegian; LANGCONFIG = Machineno.cnf;
    option[se]: name = Swedish; LANGCONFIG = Machinese.cnf; priority = 1;
end

//
// warnings
//
INCOMPATIBLE = false
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = This version is not currently playable (4.0x38)
end




