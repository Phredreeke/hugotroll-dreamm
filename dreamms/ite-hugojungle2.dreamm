desc[ite-hugojungle2]:

name = Hugo Jungle Island 2
icon = ite-hugojungle2.png
machine = pc
rootpath = C:\
launch = $(rootpath)\Jungle2.exe
osenv = windows
winres=640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// warnings
//
INCOMPATIBLE = false
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = This game is currently unplayable due to missing mouse input (4.0x35)
end

//
// Norwegian version
//
