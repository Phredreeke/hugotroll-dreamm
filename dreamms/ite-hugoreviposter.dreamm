desc[ite-hugoreviposter]:

name = Hugo Reviposter
icon = ite-hugoreviposter.png
machine = pc
rootpath = D:\
osenv = windows
winres=640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// warnings
//
INCOMPATIBLE = false
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = This version does not run correctly in tested DREAMM version (4.0x35)
end

//
// Forest
//
game[pc-ar-forest]:
    name = La Selva / Forest
    anchorfile = Forest.exe
    launch = $(rootpath)\Forest.exe
