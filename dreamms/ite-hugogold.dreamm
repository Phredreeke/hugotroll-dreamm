desc[ite-hugogold]:

name = Hugo Gold
icon = ite-hugogold.png
machine = pc
rootpath = C:\
launch = $(rootpath)\Hugo.exe
osenv = windows
winres=640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// warnings
//

CPNOTE = false
warning[incompatiblecpnote]:
    condition = $(CPNOTE)
    text = This version does not work due to Laserlock protection
end

